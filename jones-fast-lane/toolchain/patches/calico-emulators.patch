diff --git a/source/nds/arm9/bootstub_arm9.s b/source/nds/arm9/bootstub_arm9.s
index 5ffdb87..a73aecc 100644
--- a/source/nds/arm9/bootstub_arm9.s
+++ b/source/nds/arm9/bootstub_arm9.s
@@ -89,6 +89,11 @@ FUNC_START32 __ds9_bootstub, bootstub
 	@ Set up supervisor mode stack
 	ldr  sp, =__sp_svc
 
+	@ BIOS IRQ handler pointer (DTCM+0x3FFC) -> __arm_bios_irq
+	ldr  r0, =__irq_vector
+	ldr  r1, =__arm_bios_irq
+	str  r1, [r0]
+
 	@ Disable interrupts in the IRQ controller
 	mov  r11, #MM_IO
 	strb r11, [r11, #IO_IME]
diff --git a/source/nds/arm9/mpu_setup.crt0.s b/source/nds/arm9/mpu_setup.crt0.s
index 0996181..3221051 100644
--- a/source/nds/arm9/mpu_setup.crt0.s
+++ b/source/nds/arm9/mpu_setup.crt0.s
@@ -42,7 +42,7 @@ FUNC_START32 crt0SetupMPU
 	mrc   p15, 0, r3, c1, c0, 0
 	ldr   r2, =(CP15_CR_PU_ENABLE | CP15_CR_DCACHE_ENABLE | CP15_CR_ICACHE_ENABLE | CP15_CR_ROUND_ROBIN)
 	orr   r3, r3, r2
-	bic   r3, r3, #CP15_CR_ALT_VECTORS
+	@ keep CP15_CR_ALT_VECTORS: IRQs enter through the BIOS (see __arm_bios_irq)
 	mcr   p15, 0, r3, c1, c0, 0
 
 	pop   {r4-r11}
diff --git a/source/nds/arm9/nitrorom.c b/source/nds/arm9/nitrorom.c
