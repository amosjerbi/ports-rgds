#!/bin/bash
# GBA-system launch wrapper for the Aria of Sorrow companion. EmulationStation passes: ROM -Pgba --core=.. --emulator=.. --controllers=..
# Install next to aos-bottom (/storage/roms/ports/aos-companion/) and point the `gba` system's <command> in
# /storage/.config/emulationstation/es_systems.cfg at it (instead of /usr/bin/runemu.sh). Back that file up first.
#
#  * Aria of Sorrow with the mGBA core: starts aos-bottom on the lower panel, opens RetroArch's network command port only for
#    this session, and closes everything again when the game exits.
#  * Anything else: the stock launcher, unchanged.
# Create an empty "no-companion" file next to this script to get plain mGBA.
ROM="$1"
export SWAYSOCK=${SWAYSOCK:-/run/0-runtime-dir/sway-ipc.0.sock}
D=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# the ROM is usually zipped, so go by the file name as well as the header code
CODE=$(dd if="$ROM" bs=1 skip=172 count=4 2>/dev/null)
ARIA=0; { [ "$CODE" = "A2CE" ] || case "$ROM" in *"Aria of Sorrow"*) true ;; *) false ;; esac; } && ARIA=1
case " $* " in
  *"--core=mgba "*)
    if [ "$ARIA" = 1 ] && [ -x "$D/aos-bottom" ] && [ ! -e "$D/no-companion" ]; then
        . /etc/profile
        RACFG=/storage/.config/retroarch/retroarch.cfg
        sed -i 's|^network_cmd_enable = .*|network_cmd_enable = "true"|' $RACFG
        swaymsg "focus output DSI-2" >/dev/null 2>&1 # RetroArch opens on the focused output: keep it on the top panel
        SDL_VIDEODRIVER=wayland "$D/aos-bottom" > /tmp/aos-bottom.log 2>&1 &
        CP=$!
        /usr/bin/runemu.sh "$@"
        RC=$?
        kill $CP 2>/dev/null; wait $CP 2>/dev/null
        sed -i 's|^network_cmd_enable = .*|network_cmd_enable = "false"|' $RACFG
        # EmulationStation keeps the lower panel off; put it back the way it was.
        swaymsg "output DSI-1 power off" >/dev/null 2>&1
        exit $RC
    fi ;;
esac
exec /usr/bin/runemu.sh "$@"
