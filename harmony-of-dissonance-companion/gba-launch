#!/bin/bash
# GBA-system launch wrapper. EmulationStation passes: ROM -Pgba --core=.. --emulator=.. --controllers=..
# Lives next to tmc-bottom / tmc-rgds (e.g. /storage/roms/ports/tmc-rgds/). No .sh extension on purpose, so
# EmulationStation does not offer it as a Ports entry.
#
#  * Minish Cap with the mGBA core (the default): runs real mGBA in RetroArch on the top panel and starts
#    tmc-bottom, which reads the game memory over RetroArch network commands and draws the second screen
#    (map / quest / items) on the bottom panel. It exits with the emulator.
#  * Minish Cap with the "minishcap-rgds" core: the native dual-screen build (tmc-rgds, no emulator).
#  * Anything else: the stock launcher, unchanged.
# Create "no-companion" next to this script to run plain mGBA for Minish Cap.
#  * Harmony of Dissonance with the mGBA core: starts hod-bottom from /storage/roms/ports/hod-companion (see harmony-of-dissonance-companion/).
ROM="$1"
HODDIR=/storage/roms/ports/hod-companion
export SWAYSOCK=${SWAYSOCK:-/run/0-runtime-dir/sway-ipc.0.sock}
D=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
CODE=$(dd if="$ROM" bs=1 skip=172 count=4 2>/dev/null)
MINISH=0; { [ "$CODE" = "BZME" ] || [ "$CODE" = "BZMP" ]; } && MINISH=1
# Castlevania: Harmony of Dissonance (USA): the ROM may be zipped, so go by the file name as well as the header code
HOD=0; { [ "$CODE" = "ACHE" ] || case "$ROM" in *"Harmony of Dissonance"*) true ;; *) false ;; esac; } && HOD=1
case " $* " in
  *"--core=minishcap-rgds "*)
    if [ "$MINISH" = 1 ]; then
        . /etc/profile
        export SDL_VIDEODRIVER=wayland
        cd "$D" || exit 1
        swaymsg "focus output DSI-2" >/dev/null 2>&1 # new windows open on the focused output: keep the game on top
        ./tmc-rgds "$ROM"
        RC=$?
        # EmulationStation keeps the lower panel off; put it back the way it was.
        swaymsg "output DSI-1 power off" >/dev/null 2>&1
        exit $RC
    fi ;;
  *"--core=mgba "*)
    # Harmony of Dissonance: hod-bottom (SPELLBOOK / EQUIP / ITEM / RELICS / ENEMY, touch) runs on the lower panel.
    if [ "$HOD" = 1 ] && [ -x "$HODDIR/hod-bottom" ] && [ ! -e "$HODDIR/no-companion" ]; then
        . /etc/profile
        RACFG=/storage/.config/retroarch/retroarch.cfg
        sed -i 's|^network_cmd_enable = .*|network_cmd_enable = "true"|' $RACFG
        sed -i 's|^network_remote_enable = .*|network_remote_enable = "true"|; s|^network_remote_enable_user_p1 = .*|network_remote_enable_user_p1 = "true"|' $RACFG
        swaymsg "focus output DSI-2" >/dev/null 2>&1
        SDL_VIDEODRIVER=wayland "$HODDIR/hod-bottom" > /tmp/hod-bottom.log 2>&1 &
        CP=$!
        /usr/bin/runemu.sh "$@"
        RC=$?
        kill $CP 2>/dev/null; wait $CP 2>/dev/null
        sed -i 's|^network_cmd_enable = .*|network_cmd_enable = "false"|' $RACFG
        sed -i 's|^network_remote_enable = .*|network_remote_enable = "false"|; s|^network_remote_enable_user_p1 = .*|network_remote_enable_user_p1 = "false"|' $RACFG
        swaymsg "output DSI-1 power off" >/dev/null 2>&1
        exit $RC
    fi
    # The companion's RAM map is the USA one (BZME); other regions get plain mGBA.
    if [ "$CODE" = "BZME" ] && [ ! -e "$D/no-companion" ]; then
        . /etc/profile
        # RetroArch's network command port (memory reads, state load) is only open during this session.
        RACFG=/storage/.config/retroarch/retroarch.cfg
        sed -i 's|^network_cmd_enable = .*|network_cmd_enable = "true"|' $RACFG
        swaymsg "focus output DSI-2" >/dev/null 2>&1 # RetroArch opens on the focused output: keep it on the top panel
        SDL_VIDEODRIVER=wayland "$D/tmc-bottom" "$ROM" > /tmp/tmc-bottom.log 2>&1 &
        CP=$!
        /usr/bin/runemu.sh "$@"
        RC=$?
        kill $CP 2>/dev/null; wait $CP 2>/dev/null
        sed -i 's|^network_cmd_enable = .*|network_cmd_enable = "false"|' $RACFG
        # EmulationStation keeps the lower panel off; put it back the way it was.
        swaymsg "output DSI-1 power off" >/dev/null 2>&1
        exit $RC
    fi ;;
esac
exec /usr/bin/runemu.sh "$@"
