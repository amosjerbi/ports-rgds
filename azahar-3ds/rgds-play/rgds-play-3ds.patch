+// A 3DS game (Azahar's stacked layout: the 400 x 240 top screen over the 320 x 240 bottom one, centred, at any
+// resolution factor) on both panels: each panel shows its own screen, as large as fits.
+SDL_Rect dual_source(const Picture& game, bool bottom) {
+    const int half = game.h / 2;
+    if (!bottom) return {0, 0, game.w, half};
+    const int w = game.w * 320 / 400;
+    return {(game.w - w) / 2, half, w, game.h - half};
+}
+void draw_dual(Panel& p, const Picture& game, bool bottom, int fit) {
+    if (game.w != p.game_w || game.h != p.game_h) make_game_textures(p, game.w, game.h);
+    SDL_UpdateTexture(p.game, nullptr, game.px, game.stride * 4);
+    const SDL_Rect src = dual_source(game, bottom);
+    if (src.w <= 0 || src.h <= 0) return;
+    const SDL_Rect dest = fit_rect(p.area, src.w, src.h, fit == FitInteger);
+    // Smoothed unless the panel shows whole multiples (the bottom screen at 1x: exactly 2x on a 640 x 480 panel).
+    const bool whole = dest.w % src.w == 0 && dest.h % src.h == 0;
+    SDL_SetTextureScaleMode(p.game, whole || fit == FitInteger ? SDL_ScaleModeNearest : SDL_ScaleModeLinear);
+    SDL_RenderCopy(p.renderer, p.game, &src, &dest);
+    p.game_dest = dest;
+}
+
+// The same from a GPU core's frame left on the GPU: copied into the panel's game texture by the GPU (upright, after
+// the core's fence), then drawn as above. False when it can't be (the caller reads the picture back instead).
+bool draw_dual_gpu(Panel& p, const Core::GpuFrame& f, bool bottom, int fit) {
+    if (!p.gl || !panel_gl.load()) return false;
+    if (f.w != p.game_w || f.h != p.game_h) make_game_textures(p, f.w, f.h);
+    SDL_RenderFlush(p.renderer); // SDL's queued draws first: the copy below goes behind its back
+    int tw = 0, th = 0, panel_texture = 0;
+    if (SDL_GL_BindTexture(p.game, nullptr, nullptr) != 0) return false;
+    panel_gl.GetIntegerv(0x8069, &panel_texture); // GL_TEXTURE_BINDING_2D
+    SDL_GL_UnbindTexture(p.game);
+    SDL_QueryTexture(p.game, nullptr, nullptr, &tw, &th);
+    if (!panel_texture || tw != f.w || th != f.h) return false;
+    if (!p.read_fbo) panel_gl.GenFramebuffers(1, &p.read_fbo), panel_gl.GenFramebuffers(1, &p.draw_fbo);
+    if (f.fence) panel_gl.WaitSync(f.fence, 0, ~0ull); // GL_TIMEOUT_IGNORED: the GPU waits, not us
+    const bool scissor = panel_gl.IsEnabled(0x0C11);  // GL_SCISSOR_TEST would clip the copy
+    if (scissor) panel_gl.Disable(0x0C11);
+    constexpr unsigned READ = 0x8CA8, DRAW = 0x8CA9, COLOUR0 = 0x8CE0, TEX2D = 0x0DE1;
+    panel_gl.BindFramebuffer(READ, p.read_fbo);
+    panel_gl.FramebufferTexture2D(READ, COLOUR0, TEX2D, f.texture, 0);
+    panel_gl.BindFramebuffer(DRAW, p.draw_fbo);
+    panel_gl.FramebufferTexture2D(DRAW, COLOUR0, TEX2D, unsigned(panel_texture), 0);
+    // GL rows run bottom-up, the game texture's top-down: flipped in the copy.
+    panel_gl.BlitFramebuffer(0, 0, f.w, f.h, 0, f.bottom_up ? f.h : 0, f.w, f.bottom_up ? 0 : f.h,
+                             0x4000 /* GL_COLOR_BUFFER_BIT */, 0x2600 /* GL_NEAREST */);
+    panel_gl.BindFramebuffer(0x8D40, 0); // GL_FRAMEBUFFER: the window again, where SDL draws
+    if (scissor) panel_gl.Enable(0x0C11);
+    Picture size;
+    size.w = f.w, size.h = f.h;
+    const SDL_Rect src = dual_source(size, bottom);
+    const SDL_Rect dest = fit_rect(p.area, src.w, src.h, fit == FitInteger);
+    const bool whole = dest.w % src.w == 0 && dest.h % src.h == 0;
+    SDL_SetTextureScaleMode(p.game, whole || fit == FitInteger ? SDL_ScaleModeNearest : SDL_ScaleModeLinear);
+    SDL_RenderCopy(p.renderer, p.game, &src, &dest);
+    p.game_dest = dest;
+    return true;
+}
